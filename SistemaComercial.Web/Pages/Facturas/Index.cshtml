@page
@model SistemaComercial.Web.Pages.Facturas.IndexModel

<h2 class="mt-3">Facturas</h2>

@if (TempData["Mensaje"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

<p>
    <a class="btn btn-primary" asp-page="Create">
        Emitir Factura
    </a>
</p>

@if (!Model.ListaFacturas.Any())
{
    <div class="alert alert-info mt-3">
        No hay facturas emitidas todavía.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle mt-3">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Patente</th>
                <th class="text-end">Total</th>
                <th>Fecha Emisión</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in Model.ListaFacturas)
            {
                <tr>
                    <td>@f.Id</td>
                    <td>@f.Arriendo?.Cliente?.Nombre</td>
                    <td>@f.Arriendo?.Patente</td>
                    <td class="text-end">@f.Monto.ToString("C0")</td>
                    <td>@f.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}