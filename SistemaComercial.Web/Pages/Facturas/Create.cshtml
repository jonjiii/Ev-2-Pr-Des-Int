@page "{arriendoId?}"
@model SistemaComercial.Web.Pages.Facturas.CreateModel

<h2 class="mt-3">Emitir Factura</h2>

<form method="post" class="mt-3">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Arriendo</label>
        <select asp-for="Input.ArriendoId" asp-items="Model.ArriendosSelect" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label class="form-label">Total del Arriendo</label>
        <input class="form-control" value="@Model.TotalArriendo.ToString("C")" disabled />
    </div>

    <button type="submit" class="btn btn-success">Emitir Factura</button>
    <a asp-page="Index" class="btn btn-secondary">Volver</a>
</form>
