@page
@model SistemaComercial.Web.Pages.Arriendos.CreateModel

<h2 class="mt-3">Nuevo Arriendo</h2>

<div class="row mt-4">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="row">
                        <!-- Cliente -->
                        <div class="mb-3 col-md-6">
                            <label class="form-label">Cliente</label>
                            <select asp-for="Input.ClienteId"
                                    asp-items="Model.ClientesSelect"
                                    class="form-select">
                            </select>
                        </div>

                        <!-- Camioneta -->
                        <div class="mb-3 col-md-6">
                            <label class="form-label">Camioneta</label>
                            <select asp-for="Input.Patente"
                                    asp-items="Model.CamionetasSelect"
                                    class="form-select">
                                <option value="">Seleccione una camioneta...</option>
                            </select>
                            <span asp-validation-for="Input.Patente" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Precio / Tipo de camioneta -->
                        <div class="mb-3 col-md-6">
                            <label class="form-label">Tipo de camioneta / Precio por día</label>
                            <select asp-for="Input.PrecioArriendoId"
                                    asp-items="Model.PreciosSelect"
                                    class="form-select">
                            </select>
                            <span asp-validation-for="Input.PrecioArriendoId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Fecha inicio -->
                        <div class="mb-3 col-md-6">
                            <label class="form-label">Fecha inicio</label>
                            <input asp-for="Input.FechaInicio"
                                   type="date"
                                   class="form-control" />
                        </div>

                        <!-- Fecha término -->
                        <div class="mb-3 col-md-6">
                            <label class="form-label">Fecha término</label>
                            <input asp-for="Input.FechaTermino"
                                   type="date"
                                   class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-2">
                        <a asp-page="Index" class="btn btn-secondary">
                            Volver
                        </a>
                        <button type="submit" class="btn btn-success">
                            Crear arriendo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
