@page
@model SistemaComercial.Web.Pages.Arriendos.CreateModel

<h2 class="mt-3">Nuevo Arriendo</h2>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Cliente</label>
        <select asp-for="Input.ClienteId" asp-items="Model.ClientesSelect" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label class="form-label">Camioneta</label>
        <select asp-for="Input.Patente"
                asp-items="Model.CamionetasSelect"
                class="form-select">
            <option value="">Seleccione una camioneta...</option>
        </select>
        <span asp-validation-for="Input.Patente" class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label class="form-label">Tipo de camioneta</label>
        <select asp-for="Input.TipoCamioneta" asp-items="Model.TiposCamionetaSelect" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha inicio</label>
        <input asp-for="Input.FechaInicio" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha término</label>
        <input asp-for="Input.FechaTermino" type="date" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Crear</button>
    <a asp-page="Index" class="btn btn-secondary">Volver</a>
</form>

