@page
@model SistemaComercial.Web.Pages.Arriendos.CreateModel

<h2 class="mt-3">Nuevo Arriendo</h2>

<form method="post" class="mt-3">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Cliente</label>
        <select asp-for="Input.ClienteId" asp-items="Model.ClientesSelect" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Patente" class="form-label"></label>
        <input asp-for="Input.Patente" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Input.TipoCamioneta" class="form-label"></label>
        <select asp-for="Input.TipoCamioneta" asp-items="Model.TiposCamionetaSelect" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label asp-for="Input.FechaInicio" class="form-label"></label>
        <input asp-for="Input.FechaInicio" class="form-control" type="date" />
    </div>

    <div class="mb-3">
        <label asp-for="Input.FechaTermino" class="form-label"></label>
        <input asp-for="Input.FechaTermino" class="form-control" type="date" />
    </div>

    <button type="submit" class="btn btn-success">Crear Arriendo</button>
    <a asp-page="Index" class="btn btn-secondary">Volver</a>
</form>
