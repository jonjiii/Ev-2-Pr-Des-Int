@page "{id:int}"
@model SistemaComercial.Web.Pages.Arriendos.FinalizarModel

@{
    ViewData["Title"] = "Finalizar arriendo";
}

<h2 class="mt-3">Finalizar arriendo</h2>

@if (Model.Arriendo is null)
{
    <div class="alert alert-danger mt-4">
        No se encontró el arriendo solicitado.
    </div>
}
else
{
    <div class="row mt-4">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Datos del arriendo</h5>

                    <dl class="row">
                        <dt class="col-sm-3">Cliente</dt>
                        <dd class="col-sm-9">@Model.Arriendo.Cliente.Nombre</dd>

                        <dt class="col-sm-3">Patente</dt>
                        <dd class="col-sm-9">@Model.Arriendo.Patente</dd>

                        <dt class="col-sm-3">Fecha inicio</dt>
                        <dd class="col-sm-9">
                            @Model.Arriendo.FechaInicio.ToString("dd-MM-yyyy")
                        </dd>

                        <dt class="col-sm-3">Fecha término</dt>
                        <dd class="col-sm-9">
                            @Model.FechaTerminoCalculada.ToString("dd-MM-yyyy")
                            @if (!Model.EsFinalizado)
                            {
                                <small class="text-muted">
                                    (se usará esta fecha al finalizar)
                                </small>
                            }
                        </dd>

                        <dt class="col-sm-3">Días cobrados</dt>
                        <dd class="col-sm-9">@Model.DiasCobrados</dd>

                        <dt class="col-sm-3">Precio por día</dt>
                        <dd class="col-sm-9">
                            @Model.PrecioPorDia.ToString("C0")
                        </dd>

                        <dt class="col-sm-3">Total</dt>
                        <dd class="col-sm-9 fw-bold">
                            @if (Model.EsFinalizado)
                            {
                                @Model.Arriendo.PrecioTotal.ToString("C0")
                            }
                            else
                            {
                                @Model.TotalCalculado.ToString("C0")
                            }
                        </dd>
                    </dl>

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    @if (!Model.EsFinalizado)
                    {
                        <!-- FORM PARA FINALIZAR ARRIENDO -->
                        <form method="post">
                            <input type="hidden" asp-for="Id" />

                            <p>
                                ¿Confirmas que deseas finalizar este arriendo y liberar la
                                camioneta para nuevos arriendos?
                            </p>

                            <div class="d-flex justify-content-between mt-3">
                                <a asp-page="Index" class="btn btn-secondary">
                                    Volver
                                </a>

                                <button type="submit" class="btn btn-success">
                                    Confirmar finalización
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <!-- ARRIENDO YA FINALIZADO -->
                        <div class="alert alert-success">
                            Este arriendo ya se encuentra <strong>finalizado</strong>.
                        </div>

                        @if (!Model.TieneFactura)
                        {
                            <!-- FORM PARA GENERAR FACTURA -->
                            <form method="post" asp-page-handler="Facturar" class="mt-3">
                                <input type="hidden" asp-for="Id" />

                                <p>
                                    ¿Deseas generar la factura por este arriendo
                                    por un monto de
                                    <strong>@Model.Arriendo.PrecioTotal.ToString("C0")</strong>?
                                </p>

                                <div class="d-flex justify-content-between mt-3">
                                    <a asp-page="Index" class="btn btn-secondary">
                                        Volver
                                    </a>

                                    <button type="submit" class="btn btn-primary">
                                        Generar factura
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-info mt-3">
                                Este arriendo ya tiene una factura asociada
                                (ID: @Model.Arriendo.Factura!.Id).
                            </div>

                            <div class="d-flex justify-content-between mt-3">
                                <a asp-page="Index" class="btn btn-secondary">
                                    Volver
                                </a>

                                <a asp-page="/Facturas/Index" class="btn btn-outline-primary">
                                    Ir a facturas
                                </a>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}