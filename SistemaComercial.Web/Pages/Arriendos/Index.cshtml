@page
@model SistemaComercial.Web.Pages.Arriendos.IndexModel

@{
    ViewData["Title"] = "Arriendos";
}

<h2 class="mt-3">Arriendos</h2>

<div class="mt-4">
    <a asp-page="Create" class="btn btn-primary">
        Nuevo Arriendo
    </a>
</div>

<table class="table table-striped mt-4">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>Patente</th>
            <th>Fecha inicio</th>
            <th>Fecha término</th>
            <th>Total</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Arriendos)
    {
        // Arriendo se considera finalizado SOLO si la fecha de término ya pasó o es hoy.
        var estaFinalizado = item.FechaTermino.HasValue
                             && item.FechaTermino.Value.Date <= DateTime.Today;

        <tr>
            <td>@item.Cliente.Nombre</td>
            <td>@item.Patente</td>
            <td>@item.FechaInicio.ToString("dd-MM-yyyy")</td>
            <td>
                @if (item.FechaTermino.HasValue)
                {
                    @item.FechaTermino.Value.ToString("dd-MM-yyyy")
                }
                else
                {
                    <span>-</span>
                }
            </td>
            <td>
                @item.PrecioTotal.ToString("C0")
            </td>
            <td class="text-end">
                @if (estaFinalizado)
                {
                    <span class="badge bg-secondary px-3 py-2">
                        Finalizado
                    </span>
                }
                else
                {
                    <a asp-page="Finalizar"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-primary">
                        Finalizar
                    </a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>