@page
@model SistemaComercial.Web.Pages.Arriendos.IndexModel

<h2 class="mt-3">Arriendos</h2>

@if (TempData["Mensaje"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<p class="mt-3">
    <a asp-page="Create" class="btn btn-primary">Nuevo Arriendo</a>
</p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>Patente</th>
            <th>Fecha inicio</th>
            <th>Fecha término</th>
            <th>Total</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @if (!(Model.Lista?.Any() ?? false))
    {
        <tr>
            <td colspan="6" class="text-center text-muted">
                No hay arriendos registrados todavía.
            </td>
        </tr>
    }
    else
    {
        @foreach (var a in Model.Lista)
        {
            <tr>
                <td>@(a.Cliente?.Nombre ?? "Sin cliente")</td>
                <td>@a.Patente</td>
                <td>@a.FechaInicio.ToLocalTime().ToString("dd/MM/yyyy")</td>
                <td>
                    @if (a.FechaTermino is null)
                    {
                        <span class="badge bg-info text-dark">En curso</span>
                    }
                    else
                    {
                        @a.FechaTermino.Value.ToLocalTime().ToString("dd/MM/yyyy")
                    }
                </td>
                <td>@a.PrecioTotal.ToString("C0")</td>
                <td class="text-end">
                    @if (a.FechaTermino is null)
                    {
                        <form method="post"
                              asp-page-handler="Finalizar"
                              asp-route-id="@a.Id"
                              class="d-inline">
                            <button type="submit" class="btn btn-sm btn-success">
                                Finalizar
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Finalizado</span>
                    }
                </td>
            </tr>
        }
    }
    </tbody>
</table>