@page
@model SistemaComercial.Web.Pages.Arriendos.IndexModel

<h2 class="mt-3">Arriendos</h2>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (TempData["Mensaje"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

<p>
    <a asp-page="Create" class="btn btn-primary">Nuevo Arriendo</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>Patente</th>
            <th>Inicio</th>
            <th>Término</th>
            <th>Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model.Lista)
        {
            <tr>
                <td>@a.Cliente?.Nombre</td>
                <td>@a.Patente</td>
                <td>@a.FechaInicio.ToLocalTime().ToString("dd/MM/yyyy")</td>
                @(
                            a.FechaTermino is null 
                    ? "En curso"
                    : a.FechaTermino.Value.ToLocalTime().ToString("dd/MM/yyyy")
                            )

                <td>@a.PrecioTotal.ToString("C0")</td>
                <td class="text-end">
                    <form method="post" asp-page-handler="Finalizar" asp-route-id="@a.Id" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-success">
                            Finalizar
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>