@page
@model SistemaComercial.Web.Pages.Arriendos.IndexModel

<h2 class="mt-3">Arriendos</h2>

<p>
    <a class="btn btn-primary" asp-page="Create">Nuevo Arriendo</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>Patente</th>
            <th>Fecha Inicio</th>
            <th>Fecha Término</th>
            <th>Total</th>
            <th>Factura</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var a in Model.ListaArriendos)
    {
        <tr>
            <td>@a.Cliente?.Nombre</td>
            <td>@a.Patente</td>
            <td>@a.FechaInicio.ToShortDateString()</td>
            <td>@a.FechaTermino.ToShortDateString()</td>
            <td>@a.PrecioTotal.ToString("C")</td>
            <td>
                @(a.Factura is null ? "Sin factura" : $"Factura #{a.Factura.Id}")
            </td>
        </tr>
    }
    </tbody>
</table>
