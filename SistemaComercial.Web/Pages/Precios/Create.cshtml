@page
@model SistemaComercial.Web.Pages.Precios.CreateModel

<h2 class="mt-3">Nuevo Precio de Arriendo</h2>

<form method="post" class="mt-3">
    <div class="mb-3">
        <label asp-for="NuevoPrecio.TipoCamioneta" class="form-label"></label>
        <input asp-for="NuevoPrecio.TipoCamioneta" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="NuevoPrecio.PrecioPorDia" class="form-label"></label>
        <input asp-for="NuevoPrecio.PrecioPorDia" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-page="Index" class="btn btn-secondary">Volver</a>
</form>
