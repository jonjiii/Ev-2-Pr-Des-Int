@page "{id:int}"
@model SistemaComercial.Web.Pages.Precios.EditModel

<h2 class="mt-3">Editar Precio</h2>

<form method="post" class="mt-3">
    <div class="mb-3">
        <label asp-for="Precio.TipoCamioneta" class="form-label"></label>
        <input asp-for="Precio.TipoCamioneta" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Precio.PrecioPorDia" class="form-label"></label>
        <input asp-for="Precio.PrecioPorDia" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-page="Index" class="btn btn-secondary">Volver</a>
</form>
