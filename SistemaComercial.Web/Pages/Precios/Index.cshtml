@page
@model SistemaComercial.Web.Pages.Precios.IndexModel

<h2 class="mt-3">Precios de Arriendo</h2>

@if (TempData["Mensaje"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p class="mt-3">
    <a class="btn btn-primary" asp-page="Create">Nuevo Precio</a>
</p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Tipo de Camioneta</th>
            <th>Precio por Día</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @if (!(Model.ListaPrecios?.Any() ?? false))
    {
        <tr>
            <td colspan="3" class="text-center text-muted">
                No hay precios de arriendo configurados todavía.
            </td>
        </tr>
    }
    else
    {
        @foreach (var p in Model.ListaPrecios)
        {
            <tr>
                <td>@p.TipoCamioneta</td>
                <td>@p.PrecioPorDia.ToString("C0")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-warning me-1" asp-page="Edit" asp-route-id="@p.Id">
                        Editar
                    </a>
                    <a class="btn btn-sm btn-danger" asp-page="Delete" asp-route-id="@p.Id">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    }
    </tbody>
</table>