@page
@model SistemaComercial.Web.Pages.Clientes.CreateModel

<h2 class="mt-3">Nuevo Cliente</h2>

<div class="row mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NuevoCliente.Nombre" class="form-label">Nombre</label>
                        <input asp-for="NuevoCliente.Nombre" class="form-control" placeholder="Ej: Juan Pérez" />
                        <span asp-validation-for="NuevoCliente.Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NuevoCliente.Rut" class="form-label">RUT</label>
                        <input asp-for="NuevoCliente.Rut" class="form-control" placeholder="Ej: 11.111.111-1" />
                        <span asp-validation-for="NuevoCliente.Rut" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NuevoCliente.Telefono" class="form-label">Teléfono</label>
                        <input asp-for="NuevoCliente.Telefono" class="form-control" placeholder="+56 9 1234 5678" />
                        <span asp-validation-for="NuevoCliente.Telefono" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NuevoCliente.Correo" class="form-label">Correo electrónico</label>
                        <input asp-for="NuevoCliente.Correo" class="form-control" placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="NuevoCliente.Correo" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-page="Index" class="btn btn-secondary">Volver</a>
                        <button type="submit" class="btn btn-success">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>