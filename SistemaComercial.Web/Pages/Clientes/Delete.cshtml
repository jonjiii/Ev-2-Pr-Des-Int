@page "{id:int}"
@model SistemaComercial.Web.Pages.Clientes.DeleteModel

<h2 class="mt-3">Eliminar Cliente</h2>

<h4>¿Seguro que deseas eliminar este cliente?</h4>

<div class="mt-3">
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Cliente.Nombre</dd>

        <dt class="col-sm-2">RUT</dt>
        <dd class="col-sm-10">@Model.Cliente.Rut</dd>

        <dt class="col-sm-2">Teléfono</dt>
        <dd class="col-sm-10">@Model.Cliente.Telefono</dd>

        <dt class="col-sm-2">Correo</dt>
        <dd class="col-sm-10">@Model.Cliente.Correo</dd>
    </dl>
</div>

<form method="post" class="mt-3">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
</form>