@page "{id:int}"
@model SistemaMantencion.Web.Pages.Camionetas.EditModel

<h2 class="mt-3">Editar Camioneta</h2>

<form method="post">
    <input type="hidden" asp-for="Camioneta.Id" />

    <div class="mb-3">
        <label asp-for="Camioneta.Patente" class="form-label"></label>
        <input asp-for="Camioneta.Patente" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Camioneta.Kilometraje" class="form-label"></label>
        <input asp-for="Camioneta.Kilometraje" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Camioneta.Estado" class="form-label"></label>
        <select asp-for="Camioneta.Estado" class="form-select">
            <option value="Disponible">Disponible</option>
            <option value="En Arriendo">En Arriendo</option>
            <option value="En Mantencion">En Mantención</option>
        </select>
    </div>


    <div class="mb-3 form-check">
        <input asp-for="Camioneta.DisponibleParaArriendo" class="form-check-input" />
        <label asp-for="Camioneta.DisponibleParaArriendo" class="form-check-label"></label>
    </div>

    <button class="btn btn-primary" type="submit">Guardar cambios</button>
    <a asp-page="Index" class="btn btn-secondary">Volver</a>
</form>
