@page "{id:int}"
@model SistemaMantencion.Web.Pages.Camionetas.DeleteModel

<h2 class="mt-3">Eliminar Camioneta</h2>

<h4>¿Seguro que deseas eliminar esta camioneta?</h4>

<div class="mt-3">
    <dl class="row">
        <dt class="col-sm-3">Patente</dt>
        <dd class="col-sm-9">@Model.Camioneta.Patente</dd>

        <dt class="col-sm-3">Kilometraje</dt>
        <dd class="col-sm-9">@Model.Camioneta.Kilometraje km</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">@Model.Camioneta.Estado</dd>
    </dl>
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
</form>
